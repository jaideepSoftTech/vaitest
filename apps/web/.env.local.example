# apps/web — local frontend configuration

# API Base URL. Defaults to http://localhost:3001/api/v1 (real backend).
# Pointed at by the API client in src/shared/api/client.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# When set to "true", use the Prism mock server at http://localhost:4010/api/v1
# instead of the real backend. Allows frontend-only iteration without a running
# backend. Prism mock is spawned by `pnpm dev` (via concurrently) when this is
# set; see mocks/auth-openapi.yaml.
# Default: unset (use real backend).
NEXT_PUBLIC_USE_MOCK_API=
