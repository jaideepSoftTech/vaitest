# qa-platform — single source of truth for local configuration.
# Every variable is REQUIRED unless a default is given. `pnpm env:check` fails
# CI if this file and the tree of process.env.X references drift apart.

# --- Core ---
NODE_ENV=development
QA_REGION=us                      # REQUIRED — us | eu. Threaded through, never hand-plumbed.

# --- Postgres (US, primary) ---
# POSTGRES_USER/PASSWORD/DB bootstrap the container's own superuser and
# database (docker-compose.yml). `pnpm db:migrate` connects as that
# superuser once to run database/sql/010_roles.sql, which creates the three
# app-level roles below; every other migration and all app/agent traffic
# uses those roles instead (08-TEAM-SYSTEMS.md §3.2).
POSTGRES_USER=qa_platform_root
POSTGRES_PASSWORD=qa_platform_root_dev_password
POSTGRES_DB=qa_platform
DATABASE_URL=postgresql://qa_app:qa_app_dev_password@localhost:5432/qa_platform
QA_MIGRATE_PASSWORD=qa_migrate_dev_password
QA_APP_PASSWORD=qa_app_dev_password
QA_AGENT_PASSWORD=qa_agent_dev_password

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=qa_minio_root
S3_SECRET_KEY=qa_minio_dev_password
S3_BUCKET=qa-platform-artifacts

# --- Ollama (embeddings only — not required for the vertical slice) ---
OLLAMA_URL=http://localhost:11434
EMBEDDINGS_PROVIDER=deterministic  # deterministic | ollama — deterministic needs no model pull

# --- AI Gateway (DeterministicProvider is the default; no key required locally) ---
AI_GATEWAY_PROVIDER=deterministic  # deterministic | anthropic
ANTHROPIC_API_KEY=                 # only required when AI_GATEWAY_PROVIDER=anthropic

# --- App ports (see docs/runbooks/ports.md — fixed, do not change) ---
WEB_PORT=3000
API_PORT=3001
BULL_BOARD_PORT=3002
PRISM_MOCK_PORT=4010

# --- Auth (dev-only placeholder secrets — never real in any committed file) ---
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
