// ============================================================================
//  Autonomous AI Testing Platform — V1 Prisma Schema
//  Source of truth for the database. See 02-ERD.md for design rationale.
//
//  Conventions
//    - snake_case table + column names via @map/@@map; camelCase in client
//    - UUID v7 primary keys (time-sortable; generated in app layer)
//    - Every tenant-scoped table carries orgId
//    - timestamptz everywhere, UTC only
//    - Soft delete only where recovery matters (tests, folders, issues)
//
//  Requires PostgreSQL 17 with extensions: pgcrypto, citext, vector, pg_trgm
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, vector, pg_trgm]
}

// ============================================================================
//  DOMAIN 1 — IDENTITY & TENANCY
// ============================================================================

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CLOSED
}

enum DataRegion {
  US
  EU
}

model Organization {
  id          String     @id @db.Uuid
  name        String
  slug        String     @unique
  planId      String     @map("plan_id") @db.Uuid
  status      OrgStatus  @default(TRIAL)
  /// Chosen at creation, immutable. Pins Postgres + object storage locality.
  dataRegion  DataRegion @default(US) @map("data_region")
  settings    Json       @default("{}")
  /// Pre-authorize vendor support access without per-request approval.
  supportAccessPreauthorized Boolean @default(false) @map("support_access_preauthorized")
  trialEndsAt DateTime?  @map("trial_ends_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan              Plan                 @relation(fields: [planId], references: [id])
  /// No direct `users` relation — users are global identities reached through
  /// `memberships`. See the note on the User model.
  memberships       Membership[]
  projects          Project[]
  auditLogs         AuditLog[]
  embeddings        Embedding[]
  artifacts         Artifact[]
  agentRuns         AgentRun[]
  agents            Agent[]
  entitlements      OrgEntitlement[]
  usageRecords      UsageRecord[]
  identityProviders IdentityProvider[]
  domainClaims      DomainClaim[]
  invitations       Invitation[]
  supportGrants     SupportAccessGrant[]
  agentPins         TenantAgentPin[]

  @@index([planId, status])
  @@map("organizations")
}

// ============================================================================
//  DOMAIN 0 — PLANS, ENTITLEMENTS, METERING
//  See 09-MULTI-TENANCY.md §6.
// ============================================================================

model Plan {
  id        String   @id @db.Uuid
  key       String   @unique // "starter" | "pro" | "enterprise"
  name      String
  /// Default entitlement values. Overridden per-org by OrgEntitlement.
  /// { maxProjects, maxUsers, maxTests, maxExecutionsPerMonth, maxConcurrency,
  ///   maxCustomAgents, modelTiers[], monthlyAiBudgetUsd, artifactRetentionPassDays,
  ///   artifactRetentionFailDays, ssoModes[], versionPinning, auditExportDays }
  defaults  Json     @default("{}")
  /// Tier → concrete model mapping. Lets Enterprise get a better model on the
  /// same tier, and lets us swap models with no client-visible change.
  tierModels Json    @default("{}") @map("tier_models")
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]

  @@map("plans")
}

/// Per-org override of a single plan default. Absent => plan default applies.
model OrgEntitlement {
  id        String   @id @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  key       String // must match a key in Plan.defaults
  value     Json
  reason    String? // why this override exists — for support and renewal
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("org_entitlements")
}

enum UsageMetric {
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  AI_CACHED_TOKENS
  AI_COST_USD
  EXECUTIONS
  EXECUTION_MINUTES
  TESTS_CREATED
  AGENT_RUNS
  STORAGE_BYTES
  EXPLORATIONS
}

/// Daily rollup. Written from the AI Gateway and the execution engine.
/// Backfilling usage you never captured is impossible — record from run one.
model UsageRecord {
  id         String      @id @db.Uuid
  orgId      String      @map("org_id") @db.Uuid
  projectId  String?     @map("project_id") @db.Uuid
  metric     UsageMetric
  /// Attribution: which agent / tier drove the spend.
  agentKey   String?     @map("agent_key")
  modelTier  ModelTier?  @map("model_tier")
  recordedOn DateTime    @map("recorded_on") @db.Date
  value      Decimal     @db.Decimal(20, 6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// ⚠️ THIS CONSTRAINT IS A TRAP AS PRISMA GENERATES IT.
  /// projectId, agentKey, and modelTier are all nullable, and PostgreSQL
  /// defaults to NULLS DISTINCT — so an org-level row
  /// (orgId, NULL, AI_COST_USD, NULL, NULL, today) never conflicts with
  /// itself and every upsert INSERTs instead of accumulating. The metering
  /// table silently fills with duplicate partial rows, and the error surfaces
  /// as a wrong invoice, months later, unbackfillable.
  ///
  /// Declared here so the Prisma client exposes the compound key for typing.
  /// Raw-SQL migration step 11 DROPs this index and recreates it with
  /// NULLS NOT DISTINCT (PostgreSQL 15+). The metering writer uses a
  /// hand-written `INSERT … ON CONFLICT … DO UPDATE SET value = value + EXCLUDED.value`
  /// rather than Prisma's upsert, so the accumulate semantics are explicit.
  @@unique([orgId, projectId, metric, agentKey, modelTier, recordedOn])
  @@index([orgId, recordedOn(sort: Desc)])
  @@map("usage_records")
}

// ============================================================================
//  DOMAIN 0b — ENTERPRISE IDENTITY
// ============================================================================

enum IdpProtocol {
  OIDC
  SAML
}

model IdentityProvider {
  id           String      @id @db.Uuid
  orgId        String      @map("org_id") @db.Uuid
  protocol     IdpProtocol
  displayName  String      @map("display_name")
  /// OIDC: { issuer, clientId, clientSecretRef, scopes[] }
  /// SAML: { entityId, ssoUrl, x509CertRef, nameIdFormat, signRequests }
  config       Json
  /// SCIM 2.0 provisioning. Token stored by reference, never plaintext.
  scimEnabled  Boolean     @default(false) @map("scim_enabled")
  scimTokenRef String?     @map("scim_token_ref")
  /// IdP group → platform role, e.g. { "qa-leads": "ADMIN" }
  groupRoleMap Json        @default("{}") @map("group_role_map")
  enabled      Boolean     @default(false)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("identity_providers")
}

/// Verified email domain → org. Routes login to the right tenant and can
/// force SSO. Without this, enterprise users hit the password form.
model DomainClaim {
  id                 String    @id @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  domain             String    @unique @db.Citext
  verificationToken  String    @map("verification_token")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  /// When true, users on this domain cannot use password login.
  forceSso           Boolean   @default(false) @map("force_sso")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("domain_claims")
}

model Invitation {
  id           String    @id @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  email        String    @db.Citext
  role         Role      @default(VIEWER)
  tokenHash    String    @unique @map("token_hash")
  invitedByUserId String? @map("invited_by_user_id") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("invitations")
}

enum SupportGrantStatus {
  REQUESTED
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

/// Time-boxed vendor access to tenant data. There is no path to tenant data
/// that does not create a record the client can read. See 09-MULTI-TENANCY §2.7.
model SupportAccessGrant {
  id               String             @id @db.Uuid
  orgId            String             @map("org_id") @db.Uuid
  /// Vendor engineer. Not a member of the tenant org.
  requestedByEmail String             @map("requested_by_email") @db.Citext
  reason           String
  ticketRef        String?            @map("ticket_ref")
  status           SupportGrantStatus @default(REQUESTED)
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?          @map("approved_at") @db.Timestamptz(3)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([status, expiresAt])
  @@map("support_access_grants")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// GLOBAL IDENTITY — a user is NOT owned by an org. Org association comes
/// exclusively from `memberships`, so one person can belong to several orgs
/// (a contractor working across clients; a vendor engineer with a support
/// grant). An `org_id` column here would contradict `memberships`, break the
/// org switcher, and make `/auth/me` returning `orgs[]` a lie.
///
/// RLS CONSEQUENCE: `users` is the one identity table that is NOT org-scoped
/// by a simple `org_id` predicate. Its policy is membership-derived:
///   CREATE POLICY user_visibility ON users USING (
///     EXISTS (SELECT 1 FROM memberships m
///             WHERE m.user_id = users.id
///               AND m.org_id = current_setting('app.current_org_id', true)::uuid));
/// An org sees only the users it shares a membership with. Email is globally
/// unique because it is a login identity, not tenant data.
model User {
  id            String     @id @db.Uuid
  email         String     @unique @db.Citext
  passwordHash  String?    @map("password_hash")
  name          String
  avatarUrl     String?    @map("avatar_url")
  status        UserStatus @default(INVITED)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       Membership[]
  projectMembers    ProjectMember[]
  refreshTokens     RefreshToken[]
  createdTests      Test[]          @relation("TestCreatedBy")
  approvedVersions  TestVersion[]   @relation("VersionApprovedBy")
  decidedProposals  AiProposal[]
  requestedRuns     Execution[]
  assignedIssues    Issue[]         @relation("IssueAssignee")
  reportedIssues    Issue[]         @relation("IssueReporter")
  issueComments     IssueComment[]

  @@index([status])
  @@map("users")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Membership {
  id        String   @id @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("memberships")
}

/// Per-project role override. Absence => fall back to org membership role.
model ProjectMember {
  id        String   @id @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  /// A vendor engineer acting under an approved SupportAccessGrant. Kept
  /// distinct from USER so a client can filter their audit log for "everything
  /// the vendor did in my tenant" in one query. See 09-MULTI-TENANCY.md §2.7.
  SUPPORT
}

model AuditLog {
  id         String    @id @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String // "test.updated", "issue.status_changed", ...
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================================
//  DOMAIN 2 — PROJECTS & APPLICATIONS
// ============================================================================

model Project {
  id          String    @id @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  key         String // "SHOP" — used in TC-SHOP-001
  name        String
  description String?
  settings    Json      @default("{}") // { requireApproval: true, autoHeal: true, ... }
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  applications     Application[]
  folders          Folder[]
  tests            Test[]
  tags             Tag[]
  testPlans        TestPlan[]
  executions       Execution[]
  issues           Issue[]
  agentRuns        AgentRun[]
  qualitySnapshots QualitySnapshot[]
  keyCounters      KeyCounter[]

  @@unique([orgId, key])
  @@map("projects")
}

enum ApplicationType {
  WEB
  MOBILE
  API
}

model Application {
  id          String          @id @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  name        String
  type        ApplicationType @default(WEB)
  description String?
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environments     Environment[]
  explorations     Exploration[]
  pages            AppPage[]
  flows            AppFlow[]
  tests            Test[]
  executions       Execution[]
  issues           Issue[]
  qualitySnapshots QualitySnapshot[]

  @@index([projectId])
  @@map("applications")
}

model Environment {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  name          String // "QA", "Staging", "Production"
  baseUrl       String   @map("base_url")
  isDefault     Boolean  @default(false) @map("is_default")
  variables     Json     @default("{}") // non-secret config only
  healthy       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application  Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  credentials  AppCredential[]
  explorations Exploration[]
  executions   Execution[]
  testPlans    TestPlan[]
  issues       Issue[]

  @@unique([applicationId, name])
  @@map("environments")
}

enum CredentialKind {
  BASIC_LOGIN
  API_TOKEN
  OAUTH
  HEADER
  COOKIE
}

/// NEVER stores a plaintext secret. `secretRef` resolves at execution time
/// from the environment / secret manager. See ERD §3 and invariant #7.
model AppCredential {
  id            String         @id @db.Uuid
  environmentId String         @map("environment_id") @db.Uuid
  label         String
  kind          CredentialKind @default(BASIC_LOGIN)
  username      String?
  secretRef     String         @map("secret_ref") // e.g. "env:SHOP_QA_PASSWORD"
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
  @@map("app_credentials")
}

/// Per-project, per-prefix counter for human-facing keys (TC-…, BUG-…).
/// Incremented in a SERIALIZABLE transaction. See ERD §6.4.
model KeyCounter {
  id        String   @id @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  prefix    String // "TC", "BUG", "PLAN"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, prefix])
  @@map("key_counters")
}

// ============================================================================
//  DOMAIN 3 — APPLICATION KNOWLEDGE (Explorer Agent output)
// ============================================================================

enum ExplorationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Exploration {
  id            String            @id @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  environmentId String            @map("environment_id") @db.Uuid
  agentRunId    String?           @map("agent_run_id") @db.Uuid
  status        ExplorationStatus @default(QUEUED)
  scope         Json              @default("{}") // { entryUrl, maxDepth, maxPages, include[], exclude[] }
  stats         Json              @default("{}") // { pages, elements, flows, transitions, durationMs }
  error         Json?
  startedAt     DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?         @map("finished_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  agentRun    AgentRun?   @relation(fields: [agentRunId], references: [id])
  pages       AppPage[]

  @@index([applicationId, createdAt(sort: Desc)])
  @@map("explorations")
}

model AppPage {
  id                   String    @id @db.Uuid
  applicationId        String    @map("application_id") @db.Uuid
  /// Normalized identity: "/orders/:id", NOT "/orders/1043". See ERD §4.
  routeKey             String    @map("route_key")
  urlPattern           String    @map("url_pattern")
  title                String?
  name                 String? // human/AI-assigned friendly name
  description          String?
  screenshotArtifactId String?   @map("screenshot_artifact_id") @db.Uuid
  requiresAuth         Boolean   @default(false) @map("requires_auth")
  firstSeenExplorationId String? @map("first_seen_exploration_id") @db.Uuid
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  stale                Boolean   @default(false)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  firstSeen         Exploration?    @relation(fields: [firstSeenExplorationId], references: [id])
  screenshot        Artifact?       @relation(fields: [screenshotArtifactId], references: [id])
  components        AppComponent[]
  elements          AppElement[]
  flowPages         AppFlowPage[]
  transitionsFrom   AppTransition[] @relation("TransitionFrom")
  transitionsTo     AppTransition[] @relation("TransitionTo")

  @@unique([applicationId, routeKey])
  @@index([applicationId, stale])
  @@map("app_pages")
}

enum ComponentType {
  FORM
  NAVIGATION
  TABLE
  LIST
  MODAL
  CARD
  BUTTON_GROUP
  HEADER
  FOOTER
  WIDGET
  OTHER
}

model AppComponent {
  id          String        @id @db.Uuid
  pageId      String        @map("page_id") @db.Uuid
  name        String
  type        ComponentType @default(OTHER)
  description String?
  boundingBox Json?         @map("bounding_box") // { x, y, w, h }
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  page     AppPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  elements AppElement[]

  @@index([pageId])
  @@map("app_components")
}

model AppElement {
  id             String   @id @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  componentId    String?  @map("component_id") @db.Uuid
  /// The stable, human-meaningful name the test refers to: "Add to Cart"
  semanticName   String   @map("semantic_name")
  role           String? // ARIA role: button, textbox, link, ...
  accessibleName String?  @map("accessible_name")
  text           String?
  tag            String?
  attributes     Json     @default("{}")
  /// Ranked candidates: [{ strategy: "testid"|"role"|"text"|"css", value, score }]
  /// NEVER a single locator. See ERD §4.
  locatorCandidates Json  @default("[]") @map("locator_candidates")
  /// Updated by the executor on every resolution success/failure.
  stabilityScore Float    @default(0.5) @map("stability_score")
  resolveCount   Int      @default(0) @map("resolve_count")
  failCount      Int      @default(0) @map("fail_count")
  stale          Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  page          AppPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  component     AppComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  transitions   AppTransition[]

  @@index([pageId, semanticName])
  @@index([pageId, role])
  @@map("app_elements")
}

enum FlowKind {
  AUTH
  CHECKOUT
  CRUD
  SEARCH
  ONBOARDING
  CUSTOM
}

model AppFlow {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  name          String
  description   String?
  kind          FlowKind @default(CUSTOM)
  criticality   Int      @default(3) // 1 = highest
  steps         Json     @default("[]") // narrative step list from Explorer
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  flowPages   AppFlowPage[]

  @@index([applicationId, kind])
  @@map("app_flows")
}

model AppFlowPage {
  flowId String @map("flow_id") @db.Uuid
  pageId String @map("page_id") @db.Uuid
  seq    Int

  flow AppFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  page AppPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([flowId, pageId])
  @@map("app_flow_pages")
}

/// The application state graph. Populated in V1, used for path-finding post-V1.
model AppTransition {
  id               String   @id @db.Uuid
  fromPageId       String   @map("from_page_id") @db.Uuid
  toPageId         String   @map("to_page_id") @db.Uuid
  triggerElementId String?  @map("trigger_element_id") @db.Uuid
  action           String // "click", "submit", "navigate"
  observedCount    Int      @default(1) @map("observed_count")
  lastObservedAt   DateTime @default(now()) @map("last_observed_at") @db.Timestamptz(3)

  fromPage       AppPage     @relation("TransitionFrom", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage         AppPage     @relation("TransitionTo", fields: [toPageId], references: [id], onDelete: Cascade)
  triggerElement AppElement? @relation(fields: [triggerElementId], references: [id], onDelete: SetNull)

  @@unique([fromPageId, toPageId, action, triggerElementId])
  @@map("app_transitions")
}

// ============================================================================
//  DOMAIN 4 — SEMANTIC INDEX
// ============================================================================

enum EmbeddingSource {
  TEST
  PAGE
  COMPONENT
  FLOW
  FAILURE
  ISSUE
  DOCUMENT
}

/// Single polymorphic embedding table. sourceId is intentionally NOT an FK.
/// See ERD §5 for the rationale and the orphan-sweep obligation.
model Embedding {
  id         String          @id @db.Uuid
  orgId      String          @map("org_id") @db.Uuid
  sourceType EmbeddingSource @map("source_type")
  sourceId   String          @map("source_id") @db.Uuid
  content    String // the text that was embedded, kept for debugging + re-embed
  /// 768 dims — Ollama nomic-embed-text, run locally. Anthropic has no
  /// embeddings endpoint, and local embedding is free, fast, and good enough
  /// for similarity. Changing model => new dimension => full re-embed.
  embedding  Unsupported("vector(768)")
  model      String          @default("nomic-embed-text")
  dimensions Int             @default(768)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, model])
  @@index([orgId, sourceType])
  @@map("embeddings")
}
// HNSW index created in raw SQL migration — Prisma cannot express it:
//   CREATE INDEX embeddings_hnsw_idx ON embeddings
//     USING hnsw (embedding vector_cosine_ops) WITH (m = 16, ef_construction = 64);
//
// MULTI-TENANT VECTOR SEARCH: a single index + post-filter on org_id loses
// recall for small tenants as tenant count grows. V1 relies on pgvector
// iterative scan; set per-query:
//   SET LOCAL hnsw.iterative_scan = relaxed_order;
//   SET LOCAL hnsw.max_scan_tuples = 20000;
// Measured at 50 tenants / 500K rows in the Week 12 load test. If recall for
// a small tenant drops below 0.9, partition embeddings by hash(org_id) into
// 16 partitions each with its own index. See 09-MULTI-TENANCY.md §2.5.

// ============================================================================
//  DOMAIN 5 — TEST REPOSITORY
// ============================================================================

model Folder {
  id          String    @id @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  description String?
  /// Materialized ancestry: "/rootId/childId/". Enables subtree queries with
  /// LIKE 'path%' and cycle prevention. See ERD §6.3.
  path        String
  depth       Int       @default(0)
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[] @relation("FolderTree")
  tests    Test[]

  @@unique([projectId, parentId, name])
  @@index([projectId, path])
  @@map("folders")
}

enum TestPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AuthorSource {
  USER
  AGENT
}

model Test {
  id             String       @id @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  applicationId  String       @map("application_id") @db.Uuid
  folderId       String       @map("folder_id") @db.Uuid
  /// Human-facing, immutable. "TC-SHOP-001". See ERD §6.4.
  key            String
  name           String
  description    String?
  /// Structured purpose/intent: { purpose, businessValue, area, riskLevel }
  intent         Json         @default("{}")
  priority       TestPriority @default(MEDIUM)
  status         TestStatus   @default(DRAFT)
  source         AuthorSource @default(USER)
  currentVersion Int          @default(1) @map("current_version")
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdByAgentRunId String?  @map("created_by_agent_run_id") @db.Uuid
  lastExecutedAt DateTime?    @map("last_executed_at") @db.Timestamptz(3)
  lastStatus     String?      @map("last_status")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  folder         Folder             @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdByUser  User?              @relation("TestCreatedBy", fields: [createdByUserId], references: [id])
  createdByRun   AgentRun?          @relation(fields: [createdByAgentRunId], references: [id])
  steps          TestStep[]
  preconditions  TestPrecondition[]
  validations    TestValidation[]
  versions       TestVersion[]
  tags           TestTag[]
  dependsOn      TestDependency[]   @relation("DependentTest")
  dependedOnBy   TestDependency[]   @relation("DependencyTest")
  dataSets       TestDataSet[]
  executionTests ExecutionTest[]
  issueLinks     IssueTest[]

  @@unique([projectId, key])
  @@index([projectId, folderId, status])
  @@index([applicationId, status])
  @@index([projectId, lastExecutedAt(sort: Desc)])
  @@map("tests")
}

enum ActionType {
  NAVIGATE
  CLICK
  DOUBLE_CLICK
  TYPE
  CLEAR
  SELECT
  CHECK
  UNCHECK
  HOVER
  SCROLL
  UPLOAD
  PRESS_KEY
  WAIT
  ASSERT
  API_CALL
  CUSTOM
}

/// The current, live steps. Intent-based — contains NO selectors. See ERD §6.1.
model TestStep {
  id           String     @id @db.Uuid
  testId       String     @map("test_id") @db.Uuid
  seq          Int
  /// Natural-language intent. THE stable identity of the step.
  intent       String
  actionType   ActionType @map("action_type")
  /// { semantic, role, scope: { page, component }, nth? } — never a locator
  target       Json?
  /// { value, source: "literal"|"dataset"|"variable"|"generated", mask? }
  input        Json?
  /// { type: "VISIBLE"|"TEXT"|"URL"|"STATE_CHANGE"|"API"|"CUSTOM", expect, tolerance? }
  verification Json?
  optional     Boolean    @default(false)
  timeoutMs    Int        @default(15000) @map("timeout_ms")
  continueOnFail Boolean  @default(false) @map("continue_on_fail")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, seq])
  @@map("test_steps")
}

model TestPrecondition {
  id          String   @id @db.Uuid
  testId      String   @map("test_id") @db.Uuid
  seq         Int
  description String
  /// { kind: "AUTH"|"DATA"|"STATE"|"CONFIG", setup?: {...} }
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, seq])
  @@map("test_preconditions")
}

/// Test-level expected results (distinct from per-step verification).
model TestValidation {
  id          String   @id @db.Uuid
  testId      String   @map("test_id") @db.Uuid
  seq         Int
  description String
  assertion   Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, seq])
  @@map("test_validations")
}

enum ChangeKind {
  CREATE
  EDIT
  AI_UPDATE
  AI_HEAL
  RESTORE
  IMPORT
}

/// Immutable full snapshot per version — not a diff. See ERD §6.2.
model TestVersion {
  id               String       @id @db.Uuid
  testId           String       @map("test_id") @db.Uuid
  version          Int
  /// Complete serialized test: { test, steps[], preconditions[], validations[], tags[] }
  snapshot         Json
  changeKind       ChangeKind   @map("change_kind")
  changeSummary    String?      @map("change_summary")
  authorType       AuthorSource @map("author_type")
  authorUserId     String?      @map("author_user_id") @db.Uuid
  authorAgentRunId String?      @map("author_agent_run_id") @db.Uuid
  approvedByUserId String?      @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  approvedBy     User?           @relation("VersionApprovedBy", fields: [approvedByUserId], references: [id])
  authorAgentRun AgentRun?       @relation(fields: [authorAgentRunId], references: [id])
  executionTests ExecutionTest[]

  @@unique([testId, version])
  @@index([testId, createdAt(sort: Desc)])
  @@map("test_versions")
}

model Tag {
  id        String   @id @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tests   TestTag[]

  @@unique([projectId, name])
  @@map("tags")
}

model TestTag {
  testId String @map("test_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([testId, tagId])
  @@index([tagId])
  @@map("test_tags")
}

enum DependencyKind {
  REQUIRES
  SETUP_FOR
}

/// Schema present in V1; runner treats all tests as independent until post-V1.
model TestDependency {
  id              String         @id @db.Uuid
  testId          String         @map("test_id") @db.Uuid
  dependsOnTestId String         @map("depends_on_test_id") @db.Uuid
  kind            DependencyKind @default(REQUIRES)

  test      Test @relation("DependentTest", fields: [testId], references: [id], onDelete: Cascade)
  dependsOn Test @relation("DependencyTest", fields: [dependsOnTestId], references: [id], onDelete: Cascade)

  @@unique([testId, dependsOnTestId])
  @@map("test_dependencies")
}

model TestDataSet {
  id        String   @id @db.Uuid
  testId    String   @map("test_id") @db.Uuid
  name      String
  data      Json     @default("[]") // array of row objects
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, name])
  @@map("test_data_sets")
}

// ============================================================================
//  DOMAIN 6 — AGENTS & AI
// ============================================================================

enum AgentKey {
  PLANNER
  EXPLORER
  DESIGNER
  EXECUTOR
  INVESTIGATOR
  HEALER
}

enum AgentScope {
  SYSTEM
  TENANT
}

/// Clients pick a TIER, never a model ID. Lets us swap the backing model for
/// cost/quality/availability with zero client-visible change, and stops a
/// client pinning an expensive model on a high-frequency trigger.
/// Tier → model mapping lives in Plan.tierModels.
enum ModelTier {
  FAST
  BALANCED
  DEEP
}

enum AgentTrigger {
  MANUAL
  ON_FAILURE
  ON_EXPLORATION_COMPLETE
  ON_EXECUTION_COMPLETE
  ON_SCHEDULE
}

/// SYSTEM agents: vendor-owned, org_id NULL, versioned + eval-gated + rolled
/// out centrally. Clients may pin a version; they may not edit.
/// TENANT agents: client-owned, org_id NOT NULL, declarative config only.
/// See 09-MULTI-TENANCY.md §1 and §4.
model Agent {
  id          String     @id @db.Uuid
  scope       AgentScope
  /// NULL for SYSTEM agents. RLS excludes SYSTEM rows from tenant write paths.
  orgId       String?    @map("org_id") @db.Uuid
  /// Set for SYSTEM agents. NULL for TENANT agents.
  key         AgentKey?
  name        String
  description String?

  // ---- TENANT agent fields (NULL on SYSTEM agents) ----
  /// Optionally extend a system agent's behaviour.
  basedOnKey  AgentKey?  @map("based_on_key")
  /// Tenant-authored. TREATED AS HOSTILE INPUT — a prompt can never grant a
  /// capability; grants come from AgentToolGrant and the DB role.
  systemPrompt String?   @map("system_prompt")
  modelTier   ModelTier? @map("model_tier")
  /// Hard constraint on what this agent may emit. V1 tenant agents are
  /// restricted to CREATE_ISSUE — read-and-report only. See §4.3.
  outputKind  ProposalKind? @map("output_kind")
  trigger     AgentTrigger? @default(MANUAL)
  /// { applicationIds: [], folderIds: [] }
  scopeFilter Json       @default("{}") @map("scope_filter")
  /// { maxTokensPerRun, maxRunsPerDay } — capped by plan entitlement
  limits      Json       @default("{}")

  // ---- SYSTEM agent fields (NULL on TENANT agents) ----
  /// Pointer to the version currently GA. Rollback = update this pointer.
  currentVersionId String? @map("current_version_id") @db.Uuid

  enabled     Boolean    @default(true)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  org        Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs       AgentRun[]
  versions   SystemAgentVersion[] @relation("AgentVersions")
  toolGrants AgentToolGrant[]

  @@unique([orgId, name])
  @@index([scope, enabled])
  @@index([orgId, trigger, enabled])
  @@map("agents")
}
// Partial unique index (raw SQL): one row per SYSTEM agent key.
//   CREATE UNIQUE INDEX agents_system_key_uniq ON agents (key)
//     WHERE scope = 'SYSTEM';

enum VersionStage {
  DRAFT
  CANARY
  ROLLING_10
  ROLLING_50
  GA
  DEPRECATED
}

/// Vendor-authored versions of a system agent. Append-only.
/// Promotion between stages is gated on the golden eval set. See §3.
model SystemAgentVersion {
  id          String       @id @db.Uuid
  agentId     String       @map("agent_id") @db.Uuid
  /// Semver, e.g. "2.4.1"
  version     String
  stage       VersionStage @default(DRAFT)
  changelog   String?
  /// { systemPrompt, modelTier, effort, tools[], outputSchema, maxTokens }
  definition  Json
  /// Scores from the gating eval run: { schemaValidity, dupPrecision,
  /// stepResolvability, humanRated, costPerRunUsd }
  evalScores  Json?        @map("eval_scores")
  evalRunId   String?      @map("eval_run_id") @db.Uuid
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)
  deprecatedAt DateTime?   @map("deprecated_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  agent    Agent            @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  rollouts AgentRollout[]
  pins     TenantAgentPin[]
  runs     AgentRun[]

  @@unique([agentId, version])
  @@index([agentId, stage])
  @@map("system_agent_versions")
}

/// Staged rollout state. Cohort membership is a stable hash of orgId so an
/// org does not flap between versions on successive requests.
model AgentRollout {
  id             String       @id @db.Uuid
  versionId      String       @map("version_id") @db.Uuid
  stage          VersionStage
  /// 0-100. Cohort = hash(orgId) % 100 < percentage.
  percentage     Int          @default(0)
  /// Explicit opt-in orgs for CANARY, independent of percentage.
  cohortOrgIds   String[]     @map("cohort_org_ids") @db.Uuid
  enteredAt      DateTime     @default(now()) @map("entered_at") @db.Timestamptz(3)
  promotedAt     DateTime?    @map("promoted_at") @db.Timestamptz(3)
  rolledBackAt   DateTime?    @map("rolled_back_at") @db.Timestamptz(3)
  rollbackReason String?      @map("rollback_reason")

  version SystemAgentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, stage])
  @@map("agent_rollouts")
}

/// Enterprise entitlement: pin a system agent to a specific version and
/// upgrade on your own schedule.
model TenantAgentPin {
  id        String   @id @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  agentKey  AgentKey @map("agent_key")
  versionId String   @map("version_id") @db.Uuid
  reason    String?
  pinnedByUserId String? @map("pinned_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  version SystemAgentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([orgId, agentKey])
  @@map("tenant_agent_pins")
}

/// Vendor-published catalog of tools a tenant agent may be granted.
/// grantableToTenant = false marks tools reserved for system agents.
model AgentToolCatalog {
  key               String   @id // "search_tests", "propose_create_issue", ...
  name              String
  description       String
  /// JSON Schema for the tool's input, shown in the authoring UI.
  inputSchema       Json     @map("input_schema")
  /// false for bash/http/sql/filesystem and all test-mutation proposals.
  grantableToTenant Boolean  @default(false) @map("grantable_to_tenant")
  /// Read-only tools are safe on any trigger; mutating ones need review.
  isMutating        Boolean  @default(false) @map("is_mutating")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  grants AgentToolGrant[]

  @@map("agent_tool_catalog")
}

/// The runtime tool dispatcher checks THIS TABLE, not the prompt.
model AgentToolGrant {
  agentId String @map("agent_id") @db.Uuid
  toolKey String @map("tool_key")

  agent Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  AgentToolCatalog @relation(fields: [toolKey], references: [key], onDelete: Restrict)

  @@id([agentId, toolKey])
  @@map("agent_tool_grants")
}

// ---- Golden eval set: gates every system-agent promotion. See §3.2. ----

model EvalCase {
  id            String   @id @db.Uuid
  agentKey      AgentKey @map("agent_key")
  name          String
  /// Frozen inputs: prompt, application knowledge fixture, existing tests
  input         Json
  /// Known-good output plus the assertions that must hold
  expected      Json
  /// Subset flagged for human rating rather than automated scoring
  humanRated    Boolean  @default(false) @map("human_rated")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  results EvalResult[]

  @@index([agentKey, active])
  @@map("eval_cases")
}

model EvalRun {
  id         String    @id @db.Uuid
  agentKey   AgentKey  @map("agent_key")
  versionId  String?   @map("version_id") @db.Uuid
  status     String    @default("RUNNING")
  /// { passed, failed, schemaValidity, dupPrecision, stepResolvability,
  ///   avgCostUsd, humanRatedAvg }
  summary    Json      @default("{}")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  results EvalResult[]

  @@index([agentKey, startedAt(sort: Desc)])
  @@map("eval_runs")
}

model EvalResult {
  id       String  @id @db.Uuid
  runId    String  @map("run_id") @db.Uuid
  caseId   String  @map("case_id") @db.Uuid
  passed   Boolean
  score    Float?
  output   Json?
  failures Json    @default("[]")

  run  EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  case EvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([runId, caseId])
  @@map("eval_results")
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

/// What caused an agent RUN. Distinct from `AgentTrigger`, which is the
/// tenant-agent's configured trigger condition. Do not merge the two.
enum AgentRunTrigger {
  USER
  SYSTEM
  EXECUTION
  SCHEDULE
  TENANT_AGENT
}

model AgentRun {
  id            String         @id @db.Uuid
  orgId         String         @map("org_id") @db.Uuid
  projectId     String?        @map("project_id") @db.Uuid
  agentId       String         @map("agent_id") @db.Uuid
  /// Which SYSTEM agent version produced this run. NULL for tenant agents.
  /// MANDATORY for staged rollout: per-version acceptance rate is the metric
  /// that gates canary → 10% → 50% → GA, and it cannot be computed without
  /// this column. Unbackfillable once runs exist — add it in Week 1.
  agentVersionId String?       @map("agent_version_id") @db.Uuid
  parentRunId   String?        @map("parent_run_id") @db.Uuid
  /// Shared across an entire user-initiated workflow. See ERD §7.
  correlationId String         @map("correlation_id") @db.Uuid
  trigger       AgentRunTrigger @default(USER)
  status        AgentRunStatus  @default(QUEUED)
  input         Json           @default("{}")
  output        Json?
  error         Json?
  inputTokens   Int            @default(0) @map("input_tokens")
  outputTokens  Int            @default(0) @map("output_tokens")
  costUsd       Decimal        @default(0) @map("cost_usd") @db.Decimal(12, 6)
  startedAt     DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?      @map("finished_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent            Agent               @relation(fields: [agentId], references: [id])
  agentVersion     SystemAgentVersion? @relation(fields: [agentVersionId], references: [id])
  parent           AgentRun?           @relation("AgentRunTree", fields: [parentRunId], references: [id])
  children         AgentRun[]        @relation("AgentRunTree")
  actions          AgentAction[]
  proposals        AiProposal[]
  explorations     Exploration[]
  createdTests     Test[]
  authoredVersions TestVersion[]
  failureAnalyses  FailureAnalysis[]
  healingAttempts  HealingAttempt[]
  detectedIssues   Issue[]

  @@index([orgId, correlationId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  /// Drives the per-version acceptance-rate query that gates rollout promotion.
  @@index([agentVersionId, createdAt(sort: Desc)])
  @@map("agent_runs")
}

enum AgentActionType {
  LLM_CALL
  TOOL_CALL
  OBSERVATION
  DECISION
  RETRIEVAL
}

model AgentAction {
  id         String          @id @db.Uuid
  agentRunId String          @map("agent_run_id") @db.Uuid
  seq        Int
  type       AgentActionType
  name       String // "generate_test_cases", "resolve_element", ...
  input      Json            @default("{}")
  output     Json?
  model      String?
  inputTokens  Int?          @map("input_tokens")
  outputTokens Int?          @map("output_tokens")
  latencyMs  Int?            @map("latency_ms")
  confidence Float?
  error      Json?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, seq])
  @@map("agent_actions")
}

enum ProposalKind {
  CREATE_TESTS
  UPDATE_TEST
  HEAL_STEP
  CREATE_ISSUE
  LINK_DUPLICATE
  UPDATE_KNOWLEDGE
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  AUTO_APPLIED
}

/// THE enforcement point for the AI/deterministic boundary. An agent cannot
/// write to the repository; it can only produce a proposal that a
/// deterministic, RBAC-checked service materializes. See ERD §7 + invariant #6.
model AiProposal {
  id              String         @id @db.Uuid
  agentRunId      String         @map("agent_run_id") @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  kind            ProposalKind
  /// Schema-validated payload. Shape depends on `kind`.
  payload         Json
  rationale       String?
  confidence      Float?
  status          ProposalStatus @default(PENDING)
  decidedByUserId String?        @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?        @map("decision_note")
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  agentRun  AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation(fields: [decidedByUserId], references: [id])

  @@index([projectId, status, createdAt(sort: Desc)])
  @@map("ai_proposals")
}

// ============================================================================
//  DOMAIN 7 — EXECUTION
// ============================================================================

model TestPlan {
  id            String   @id @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  environmentId String   @map("environment_id") @db.Uuid
  name          String
  description   String?
  /// { folderIds[], tagIds[], testIds[], priority[], nlQuery? }
  selection     Json     @default("{}")
  scheduleCron  String?  @map("schedule_cron")
  concurrency   Int      @default(4)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  executions  Execution[]

  @@unique([projectId, name])
  @@map("test_plans")
}

enum ExecutionTrigger {
  MANUAL
  SCHEDULED
  API
  RETEST
  CI
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  PARTIAL
  CANCELLED
  ERROR
}

model Execution {
  id                String           @id @db.Uuid
  orgId             String           @map("org_id") @db.Uuid
  projectId         String           @map("project_id") @db.Uuid
  applicationId     String           @map("application_id") @db.Uuid
  environmentId     String           @map("environment_id") @db.Uuid
  testPlanId        String?          @map("test_plan_id") @db.Uuid
  trigger           ExecutionTrigger @default(MANUAL)
  status            ExecutionStatus  @default(QUEUED)
  /// { total, passed, failed, skipped, healed, flaky }
  totals            Json             @default("{}")
  concurrency       Int              @default(4)
  config            Json             @default("{}") // { headless, viewport, retries, video }
  requestedByUserId String?          @map("requested_by_user_id") @db.Uuid
  /// Set when this run was triggered to verify an issue fix.
  retestIssueId     String?          @map("retest_issue_id") @db.Uuid
  startedAt         DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?        @map("finished_at") @db.Timestamptz(3)
  durationMs        Int?             @map("duration_ms")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  environment Environment      @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  testPlan    TestPlan?        @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  requestedBy User?            @relation(fields: [requestedByUserId], references: [id])
  tests       ExecutionTest[]
  events      ExecutionEvent[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([applicationId, createdAt(sort: Desc)])
  @@map("executions")
}

enum ExecutionTestStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
  BLOCKED
  ERROR
}

model ExecutionTest {
  id            String              @id @db.Uuid
  executionId   String              @map("execution_id") @db.Uuid
  testId        String              @map("test_id") @db.Uuid
  /// MANDATORY — a result is meaningless without the version. Invariant #4.
  testVersionId String              @map("test_version_id") @db.Uuid
  status        ExecutionTestStatus @default(PENDING)
  attempt       Int                 @default(1)
  workerId      String?             @map("worker_id")
  healed        Boolean             @default(false)
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?           @map("finished_at") @db.Timestamptz(3)
  durationMs    Int?                @map("duration_ms")

  execution   Execution        @relation(fields: [executionId], references: [id], onDelete: Cascade)
  test        Test             @relation(fields: [testId], references: [id], onDelete: Restrict)
  testVersion TestVersion      @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  steps       ExecutionStep[]
  failures    Failure[]
  events      ExecutionEvent[]
  artifacts   Artifact[]

  @@unique([executionId, testId, attempt])
  @@index([executionId, status])
  @@index([testId, startedAt(sort: Desc)])
  @@map("execution_tests")
}

enum StepStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
  HEALED
}

/// How the executor found the element. Aggregating this is the single best
/// health signal for the platform itself. See ERD §8.
enum ResolutionStrategy {
  EXACT
  SEMANTIC
  LLM
  HEALED
  NONE
}

model ExecutionStep {
  id                   String              @id @db.Uuid
  executionTestId      String              @map("execution_test_id") @db.Uuid
  testStepId           String?             @map("test_step_id") @db.Uuid
  seq                  Int
  intent               String
  status               StepStatus          @default(PENDING)
  action               Json                @default("{}")
  resolvedTarget       Json?               @map("resolved_target")
  resolutionStrategy   ResolutionStrategy? @map("resolution_strategy")
  resolutionConfidence Float?              @map("resolution_confidence")
  error                Json?
  startedAt            DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?           @map("finished_at") @db.Timestamptz(3)
  durationMs           Int?                @map("duration_ms")

  executionTest   ExecutionTest    @relation(fields: [executionTestId], references: [id], onDelete: Cascade)
  artifacts       Artifact[]
  failures        Failure[]
  healingAttempts HealingAttempt[]
  events          ExecutionEvent[]

  @@unique([executionTestId, seq])
  @@index([executionTestId, status])
  @@map("execution_steps")
}
// NOT PARTITIONED in V1 — deliberate. See ERD §12.1.
// Partitioning would force `started_at` into the primary key and into the
// (execution_test_id, seq) unique constraint, which would destroy the
// guarantee that a step sequence is unique within a test run. ~30M rows/year
// is comfortably within range for a well-indexed unpartitioned table.
// Revisit post-V1 only if measurement justifies it.

enum EventLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Append-only. WebSocket source for the live run UI. Highest-volume table.
/// Partitioned monthly, pruned at 90 days by DROP PARTITION. See ERD §12.
model ExecutionEvent {
  id              String     @db.Uuid
  executionId     String     @map("execution_id") @db.Uuid
  executionTestId String?    @map("execution_test_id") @db.Uuid
  executionStepId String?    @map("execution_step_id") @db.Uuid
  type            String // "step.started", "element.resolved", "heal.applied"
  level           EventLevel @default(INFO)
  message         String
  data            Json       @default("{}")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  execution     Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionTest ExecutionTest? @relation(fields: [executionTestId], references: [id], onDelete: Cascade)
  executionStep ExecutionStep? @relation(fields: [executionStepId], references: [id], onDelete: Cascade)

  /// Composite PK is REQUIRED: PostgreSQL demands the partition key in every
  /// unique constraint. This table has no other unique constraint, so
  /// partitioning costs nothing here — unlike execution_steps. See ERD §12.1.
  @@id([id, createdAt])
  @@index([executionId, createdAt])
  @@index([executionTestId, createdAt])
  @@map("execution_events")
}
// PARTITIONED BY RANGE (created_at) — monthly, pruned at 90d by DROP PARTITION.
// Applied via raw SQL migration. This is the ONLY partitioned table in V1.

// ============================================================================
//  DOMAIN 8 — ARTIFACTS
// ============================================================================

enum ArtifactKind {
  SCREENSHOT
  VIDEO
  TRACE
  HAR
  CONSOLE_LOG
  NETWORK_LOG
  DOM_SNAPSHOT
  REPORT
  OTHER
}

/// Metadata only. Bytes live in MinIO/S3 at `storageKey`. `expiresAt` drives
/// the lifecycle sweep — without it, traces and video will eat terabytes.
model Artifact {
  id              String       @id @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  kind            ArtifactKind
  bucket          String
  storageKey      String       @map("storage_key")
  contentType     String       @map("content_type")
  sizeBytes       BigInt       @map("size_bytes")
  checksum        String?
  executionTestId String?      @map("execution_test_id") @db.Uuid
  executionStepId String?      @map("execution_step_id") @db.Uuid
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  executionTest ExecutionTest?  @relation(fields: [executionTestId], references: [id], onDelete: Cascade)
  executionStep ExecutionStep?  @relation(fields: [executionStepId], references: [id], onDelete: Cascade)
  pages         AppPage[]
  issueLinks    IssueArtifact[]

  @@unique([bucket, storageKey])
  @@index([executionTestId, kind])
  @@index([expiresAt])
  @@map("artifacts")
}

// ============================================================================
//  DOMAIN 9 — FAILURE & HEALING
// ============================================================================

enum FailureCategory {
  PRODUCT_BUG
  TEST_DEFECT
  ENVIRONMENT
  DATA
  FLAKY
  UNKNOWN
}

model Failure {
  id              String          @id @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  executionTestId String          @map("execution_test_id") @db.Uuid
  executionStepId String?         @map("execution_step_id") @db.Uuid
  category        FailureCategory @default(UNKNOWN)
  /// Stable grouping hash over (normalized message + step intent + route).
  /// Groups the same failure across runs. See ERD §9.
  signature       String
  message         String
  stack           String?
  context         Json            @default("{}")
  occurrenceCount Int             @default(1) @map("occurrence_count")
  firstSeenAt     DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  executionTest   ExecutionTest    @relation(fields: [executionTestId], references: [id], onDelete: Cascade)
  executionStep   ExecutionStep?   @relation(fields: [executionStepId], references: [id], onDelete: Cascade)
  analyses        FailureAnalysis[]
  healingAttempts HealingAttempt[]
  issues          Issue[]

  @@index([orgId, signature, lastSeenAt(sort: Desc)])
  @@index([executionTestId])
  @@map("failures")
}

model FailureAnalysis {
  id                String           @id @db.Uuid
  failureId         String           @map("failure_id") @db.Uuid
  agentRunId        String           @map("agent_run_id") @db.Uuid
  rootCause         String           @map("root_cause")
  suggestedCategory FailureCategory  @map("suggested_category")
  confidence        Float
  /// { screenshots[], logs[], domDiff, networkAnomalies[], priorOccurrences }
  evidence          Json             @default("{}")
  recommendation    String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  failure  Failure  @relation(fields: [failureId], references: [id], onDelete: Cascade)
  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([failureId, createdAt(sort: Desc)])
  @@map("failure_analyses")
}

enum HealingStrategy {
  ALTERNATIVE_LOCATOR
  SEMANTIC_RESOLVE
  WAIT_RETRY
  FLOW_REROUTE
  INPUT_ADJUST
}

enum HealingOutcome {
  SUCCEEDED
  FAILED
  SKIPPED
}

model HealingAttempt {
  id              String          @id @db.Uuid
  executionStepId String          @map("execution_step_id") @db.Uuid
  failureId       String?         @map("failure_id") @db.Uuid
  agentRunId      String          @map("agent_run_id") @db.Uuid
  strategy        HealingStrategy
  before          Json            @default("{}")
  after           Json            @default("{}")
  outcome         HealingOutcome
  confidence      Float?
  /// false = run-scoped heal only. true = the repository test was updated
  /// (requires an ACCEPTED AiProposal). Safe default is false. See ERD §9.
  appliedToTest   Boolean         @default(false) @map("applied_to_test")
  proposalId      String?         @map("proposal_id") @db.Uuid
  durationMs      Int?            @map("duration_ms")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  executionStep ExecutionStep @relation(fields: [executionStepId], references: [id], onDelete: Cascade)
  failure       Failure?      @relation(fields: [failureId], references: [id], onDelete: SetNull)
  agentRun      AgentRun      @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([executionStepId])
  @@index([outcome, createdAt(sort: Desc)])
  @@map("healing_attempts")
}

// ============================================================================
//  DOMAIN 10 — ISSUES & QUALITY
// ============================================================================

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  FIXED
  RETESTING
  VERIFIED
  CLOSED
  REJECTED
  DUPLICATE
}

model Issue {
  id                  String        @id @db.Uuid
  orgId               String        @map("org_id") @db.Uuid
  projectId           String        @map("project_id") @db.Uuid
  applicationId       String?       @map("application_id") @db.Uuid
  environmentId       String?       @map("environment_id") @db.Uuid
  /// Human-facing, immutable. "BUG-000124".
  key                 String
  title               String
  description         String?
  severity            IssueSeverity @default(MEDIUM)
  status              IssueStatus   @default(OPEN)
  source              AuthorSource  @default(AGENT)
  failureId           String?       @map("failure_id") @db.Uuid
  detectedByAgentRunId String?      @map("detected_by_agent_run_id") @db.Uuid
  assigneeUserId      String?       @map("assignee_user_id") @db.Uuid
  reporterUserId      String?       @map("reporter_user_id") @db.Uuid
  duplicateOfId       String?       @map("duplicate_of_id") @db.Uuid
  /// Set while an auto-retest execution is in flight.
  retestExecutionId   String?       @map("retest_execution_id") @db.Uuid
  closedAt            DateTime?     @map("closed_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  environment Environment?    @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  failure     Failure?        @relation(fields: [failureId], references: [id], onDelete: SetNull)
  detectedBy  AgentRun?       @relation(fields: [detectedByAgentRunId], references: [id])
  assignee    User?           @relation("IssueAssignee", fields: [assigneeUserId], references: [id])
  reporter    User?           @relation("IssueReporter", fields: [reporterUserId], references: [id])
  duplicateOf Issue?          @relation("IssueDuplicate", fields: [duplicateOfId], references: [id])
  duplicates  Issue[]         @relation("IssueDuplicate")
  tests       IssueTest[]
  comments    IssueComment[]
  history     IssueHistory[]
  artifacts   IssueArtifact[]

  @@unique([projectId, key])
  @@index([projectId, status, severity])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([assigneeUserId, status])
  @@map("issues")
}

enum IssueTestRelation {
  DETECTED_BY
  AFFECTED
}

/// Drives autonomous retest: on FIXED, dispatch an execution over these tests.
model IssueTest {
  issueId  String            @map("issue_id") @db.Uuid
  testId   String            @map("test_id") @db.Uuid
  relation IssueTestRelation @default(AFFECTED)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  test  Test  @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([issueId, testId])
  @@index([testId])
  @@map("issue_tests")
}

model IssueComment {
  id         String    @id @db.Uuid
  issueId    String    @map("issue_id") @db.Uuid
  authorType ActorType @map("author_type")
  authorId   String?   @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
  @@map("issue_comments")
}

model IssueHistory {
  id        String    @id @db.Uuid
  issueId   String    @map("issue_id") @db.Uuid
  field     String
  fromValue String?   @map("from_value")
  toValue   String?   @map("to_value")
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_history")
}

model IssueArtifact {
  issueId    String @map("issue_id") @db.Uuid
  artifactId String @map("artifact_id") @db.Uuid

  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([issueId, artifactId])
  @@map("issue_artifacts")
}

/// Daily rollup. Never computed live on dashboard load. See ERD §10.
model QualitySnapshot {
  id                  String   @id @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  applicationId       String?  @map("application_id") @db.Uuid
  capturedOn          DateTime @map("captured_on") @db.Date
  overallScore        Int      @map("overall_score") // 0-100
  functionalCoverage  Float    @map("functional_coverage")
  criticalCoverage    Float    @map("critical_coverage")
  stability           Float
  healingSuccessRate  Float    @map("healing_success_rate")
  openCritical        Int      @default(0) @map("open_critical")
  openHigh            Int      @default(0) @map("open_high")
  /// { "Payments": 0.76, "Checkout": 0.82, ... } — user-defined, unstable keys
  areaHealth          Json     @default("{}") @map("area_health")
  raw                 Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([projectId, applicationId, capturedOn])
  @@index([projectId, capturedOn(sort: Desc)])
  @@map("quality_snapshots")
}

// ============================================================================
//  RAW SQL MIGRATIONS REQUIRED (Prisma cannot express these)
//  Systems + Backend own these; they run as `prisma migrate` custom SQL steps.
//
//  1. CREATE EXTENSION IF NOT EXISTS vector, citext, pgcrypto, pg_trgm;
//  2. HNSW index on embeddings.embedding (vector_cosine_ops, m=16, ef=64)
//  3. Monthly RANGE partitioning + retention job for execution_events ONLY
//        (created_at, 90d retention, pruned by DROP PARTITION).
//        execution_steps is deliberately NOT partitioned — see ERD §12.1.
//  4. Trigger: reject UPDATE of tests.key / issues.key  (invariant #9)
//  5. Trigger: maintain folders.path + depth; reject cycles  (invariant #2)
//  6. GIN trgm index on tests.name, issues.title for fuzzy search
//  7. DB ROLE SEPARATION — three roles, both boundaries:
//        CREATE ROLE qa_migrate BYPASSRLS;   -- DDL only, never the runtime
//        CREATE ROLE qa_app;                 -- API + workers, RLS enforced
//        CREATE ROLE qa_agent;               -- agent runtime, RLS enforced
//        GRANT SELECT ON ALL TABLES IN SCHEMA public TO qa_agent;
//        GRANT INSERT ON agent_runs, agent_actions, ai_proposals,
//                        embeddings, execution_events, usage_records TO qa_agent;
//        -- deliberately NO insert/update on tests, test_steps, issues.
//        -- qa_agent carries BOTH restrictions: it cannot write to the
//        -- repository (AI/deterministic boundary) and it cannot read across
//        -- tenants (isolation boundary). A prompt-injected agent — whether
//        -- injected via a hostile web page or a tenant's own agent prompt —
//        -- is contained by both.
//
//  8. ROW-LEVEL SECURITY on every tenant-scoped table. THE isolation
//     mechanism — application-level `WHERE org_id = ?` is only a perf hint.
//     FORCE matters: without it the table owner bypasses the policy, and
//     that is the role staging accidentally connects as.
//        ALTER TABLE <t> ENABLE ROW LEVEL SECURITY;
//        ALTER TABLE <t> FORCE  ROW LEVEL SECURITY;
//        CREATE POLICY tenant_isolation ON <t>
//          USING      (org_id = current_setting('app.current_org_id', true)::uuid)
//          WITH CHECK (org_id = current_setting('app.current_org_id', true)::uuid);
//     Tables reached only via a parent (test_steps, execution_steps, …) join
//     to their parent's org_id in the policy predicate.
//     TWO tables need a non-standard policy.
//     (a) `users` — a global identity with no org_id. Membership-derived:
//        CREATE POLICY user_visibility ON users USING (
//          EXISTS (SELECT 1 FROM memberships m
//                  WHERE m.user_id = users.id
//                    AND m.org_id = current_setting('app.current_org_id', true)::uuid));
//     (b) `agents` — SYSTEM rows have org_id IS NULL:
//        CREATE POLICY agent_visibility ON agents
//          USING (scope = 'SYSTEM'
//                 OR org_id = current_setting('app.current_org_id', true)::uuid)
//          WITH CHECK (scope = 'TENANT'
//                 AND org_id = current_setting('app.current_org_id', true)::uuid);
//     -- read system agents, write only your own.
//
//  9. Partial unique index: one row per SYSTEM agent key
//        CREATE UNIQUE INDEX agents_system_key_uniq ON agents (key)
//          WHERE scope = 'SYSTEM';
//
