{
  "name": "@qa/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,mock -c blue,magenta \"next dev -p ${WEB_PORT:-3000}\" \"prism mock mocks/auth-openapi.yaml -p ${PRISM_MOCK_PORT:-4010} --dynamic\"",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3000}",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "mock:validate": "redocly lint mocks/auth-openapi.yaml --config .redocly.yaml",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@tanstack/react-query": "^5.62.11",
    "zustand": "^5.0.2",
    "zod": "catalog:",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "react-hook-form": "^7.51.3",
    "@hookform/resolvers": "^3.3.4"
  },
  "devDependencies": {
    "@qa/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "storybook": "^8.4.7",
    "concurrently": "^8.2.2",
    "@stoplight/prism-cli": "^5.1.0",
    "@redocly/cli": "^1.25.15"
  }
}
