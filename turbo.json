{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "pnpm-lock.yaml", "packages/config/**"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "QA_REGION"],
  "tasks": {
    "db:generate": {
      "inputs": ["database/schema.prisma"],
      "outputs": ["node_modules/.prisma/**", "node_modules/@prisma/client/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "app/**", "public/**", "package.json", "tsconfig.json", "!**/*.test.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build", "db:generate"], "outputs": [] },
    "lint": { "outputs": [] },
    "test:unit": { "dependsOn": ["^build", "db:generate"], "outputs": ["coverage/**"] },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "S3_ACCESS_KEY", "S3_SECRET_KEY"],
      "cache": false
    },
    "test:isolation": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "API_BASE_URL", "OPENAPI_SPEC"],
      "cache": false
    },
    "test:e2e": { "dependsOn": ["build"], "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
